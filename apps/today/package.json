{
  "name": "@cn/today",
  "productName": "Canvas Today",
  "version": "0.3.8",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:helper": "node scripts/build-helper.mjs",
    "test:e2e": "electron-vite build && node scripts/build-helper.mjs && playwright test",
    "dist:mac": "electron-vite build && node scripts/build-helper.mjs && electron-builder --mac --arm64 --config electron-builder.cjs"
  },
  "devDependencies": {
    "@cn/atomic": "workspace:*",
    "@cn/calendar": "workspace:*",
    "@cn/design": "workspace:*",
    "@cn/family": "workspace:*",
    "@cn/ai-chat": "workspace:*",
    "@cn/ai-engines": "workspace:*",
    "@cn/format": "workspace:*",
    "@cn/git": "workspace:*",
    "@cn/quit-fast": "workspace:*",
    "@cn/tasks": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "description": "任务软件：任务就是画布笔记库里的一行「- [ ]」，今天、日历、四象限、到点提醒",
